{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proba.example/schemas/topic.schema.json",
  "title": "Тема",
  "description": "Контракт 0.1.0. Домен example служит идентификатором, не действующим API.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "specialty": {
      "type": "string",
      "enum": [
        "cosmetology",
        "dermatology",
        "gynecology"
      ]
    },
    "language": {
      "const": "ru"
    },
    "audience": {
      "const": "professionals"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "inclusion_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "exclusion_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "active",
        "completed",
        "cancelled"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "id",
    "is_synthetic",
    "specialty",
    "language",
    "audience",
    "title",
    "question",
    "inclusion_criteria",
    "exclusion_criteria",
    "status",
    "created_at"
  ],
  "additionalProperties": false
}
