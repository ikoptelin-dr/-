{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proba.example/schemas/article.schema.json",
  "title": "Материал",
  "description": "Контракт 0.1.0. Домен example служит идентификатором, не действующим API.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "is_synthetic": {
      "type": "boolean"
    },
    "topic_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "specialty": {
      "type": "string",
      "enum": [
        "cosmetology",
        "dermatology",
        "gynecology"
      ]
    },
    "language": {
      "const": "ru"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "body_markdown": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0,
            "uniqueItems": true
          },
          "support": {
            "type": "string",
            "enum": [
              "supported",
              "limited",
              "unsupported",
              "disputed"
            ]
          },
          "evidence_notes": {
            "type": "string",
            "minLength": 1
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "text",
          "source_ids",
          "support",
          "evidence_notes",
          "limitations"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "support": {
                  "enum": [
                    "supported",
                    "limited"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "source_ids": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      },
      "minItems": 1
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "disclosures": {
      "type": "string",
      "minLength": 1
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "briefing",
        "research",
        "evidence",
        "drafting",
        "qa",
        "in_review",
        "changes_requested",
        "approved",
        "rejected",
        "published",
        "withdrawn"
      ]
    },
    "review_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "publication": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "published_at": {
              "type": "string",
              "format": "date-time"
            },
            "publisher_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "url",
            "published_at",
            "publisher_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema_version",
    "id",
    "is_synthetic",
    "topic_id",
    "version",
    "specialty",
    "language",
    "title",
    "body_markdown",
    "claims",
    "source_ids",
    "disclosures",
    "content_hash",
    "status",
    "review_id",
    "publication",
    "updated_at"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "approved",
              "published"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "review_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "published"
          }
        }
      },
      "then": {
        "properties": {
          "publication": {
            "type": "object"
          }
        }
      }
    }
  ]
}
