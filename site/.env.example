# Пример переменных окружения сайта Proba. Реальные значения — только в .env (не в git) или хранилище секретов.

# Сборка
PROBA_PREVIEW=0                 # 1 — предпросмотр: черновики видны с плашкой, всё noindex
# PROBA_FORMS_ENDPOINT=https://forms.example/api/forms   # переопределяет forms_endpoint из proba.config.json

# Сервер форм
PROBA_FORMS_HOST=127.0.0.1
PROBA_FORMS_PORT=8787
PROBA_FORMS_DIR=./var/forms     # хранилище заявок (на сервере в РФ — решение владельца)
PROBA_SITE_ORIGIN=http://localhost:4321
PROBA_TRUST_PROXY=0             # 1 — брать IP из X-Forwarded-For (только за своим прокси)

# Уведомления в Telegram (секрет). Пусто — уведомления выключены, заявки только сохраняются.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
