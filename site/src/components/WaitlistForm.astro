---
// Лист ожидания (вебинар или клуб). ТЗ, раздел 5.
import { config } from '../lib/config.mjs';
import ConsentCheckbox from './ConsentCheckbox.astro';
import Honeypot from './Honeypot.astro';
interface Props { formType: 'webinar_waitlist' | 'club_waitlist'; subject?: string; heading?: string; bare?: boolean; submit?: string }
const { formType, subject = '', heading = 'Лист ожидания', bare = false, submit = 'Записаться в лист ожидания' } = Astro.props;
const id = `form-${formType}`;
---
<section aria-labelledby={id} class={bare ? '' : 'form-section'} id={bare ? undefined : `${id}-box`}>
  <h2 id={id} hidden={bare}>{heading}</h2>
  <form method="post" action={`${config.forms_endpoint}/${formType}`} data-form={formType}>
    <input type="hidden" name="subject" value={subject} />
    <Honeypot />
    <label class="field"><span class="field__label">Имя</span><input type="text" name="name" required maxlength="100" autocomplete="name" placeholder="Как к вам обращаться" /></label>
    <label class="field"><span class="field__label">Email или Telegram</span><input type="text" name="contact" required maxlength="100" autocomplete="email" placeholder="name@mail.ru или @username" /></label>
    <fieldset>
      <legend>Кто вы</legend>
      <div class="choices">
        <label class="choice"><input type="radio" name="role" value="cosmetologist" required /><span>Косметолог</span></label>
        <label class="choice"><input type="radio" name="role" value="doctor" /><span>Врач</span></label>
        <label class="choice"><input type="radio" name="role" value="other" /><span>Другое</span></label>
      </div>
    </fieldset>
    <label class="field"><span class="field__label">Город</span><input type="text" name="city" maxlength="100" autocomplete="address-level2" placeholder="Необязательно" /></label>
    <ConsentCheckbox />
    <button class="btn btn--block" type="submit">{submit} <span class="arrow">→</span></button>
  </form>
</section>
