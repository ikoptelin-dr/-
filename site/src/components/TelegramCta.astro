---
// Блок «Получить в Telegram»: ссылка на бота с параметром материала (?start=pamyatka_guby).
import { config } from '../lib/config.mjs';
import { botStartParam } from '../lib/rules.mjs';
interface Props { prefix: string; slug: string; text?: string }
const { prefix, slug, text = 'Получить в Telegram' } = Astro.props;
const param = botStartParam(prefix, slug);
const href = config.telegram.bot_url ? `${config.telegram.bot_url}?start=${param}` : null;
---
<aside class="cta-band" aria-label="Получить в Telegram" data-telegram-cta data-start={param}>
  <p class="eyebrow">Telegram-бот</p>
  <h2>{text}</h2>
  {href ? (
    <p><a class="btn" href={href} rel="noopener">Открыть бота <span class="arrow">→</span></a></p>
  ) : (
    <p><span class="btn btn--disabled">Бот скоро заработает</span></p>
  )}
</aside>
