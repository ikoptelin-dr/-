---
// Шаблон материала (ТЗ, раздел 4, п. 3).
import Base from './Base.astro';
import ReviewBlock from '../components/ReviewBlock.astro';
import Sources from '../components/Sources.astro';
import TelegramCta from '../components/TelegramCta.astro';
import { materialJsonLd } from '../lib/jsonld.mjs';
import { botStartForMaterial } from '../lib/rules.mjs';

interface Props { m: any }
const { m } = Astro.props;
const d = m.data;
const start = botStartForMaterial(d);
const [prefix, ...rest] = start.split('_');
const fmt = (x: Date) => x.toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
const KIND = { razbor: 'Разбор исследования', 'ne-akne': 'Это не акне', pamyatka: 'Памятка пациенту', article: 'Материал', hub: 'Раздел' } as Record<string, string>;
// Ссылка «назад»: на хаб, если у него есть страница, иначе на раздел.
const HUB_PAGES = ['/pro/ne-akne/', '/pro/pamyatki/', '/pro/razbory/', '/dlya-vseh/posle-procedur/'];
const hubPath = m.path.split('/').slice(0, 3).join('/') + '/';
const back = HUB_PAGES.includes(hubPath) ? hubPath : `/${d.section}/`;
---
<Base title={d.title} description={d.summary} path={m.path} noindex={!m.indexable} ogType="article" jsonLd={materialJsonLd(m)}>
  <article data-material data-kind={d.kind} data-medical={String(d.medical)}>
    <header class="page-head">
      <div class="container">
        <p class="eyebrow"><a href={back}>{KIND[d.kind]}</a></p>
        <p class="page-head__badges">
          {m.decision.draft && <span class="badge badge--draft" data-draft-badge>Черновик</span>}
          {d.pro_only && <span class="badge badge--pro">Для специалистов</span>}
          <span class="badge">Обновлено <time datetime={d.updated_at.toISOString().slice(0, 10)}>{fmt(d.updated_at)}</time></span>
        </p>
        {d.sponsored && (
          <p class="notice" data-ad-label><strong>Реклама.</strong> Рекламодатель: {d.sponsored.sponsor}{d.sponsored.marking_erid && <>. erid: {d.sponsored.marking_erid}</>}</p>
        )}
        <h1>{d.title}</h1>
        <p class="lead">{d.summary}</p>
      </div>
    </header>

    <div class="container page-body">
      <div>
        {d.pro_only && (
          <p class="notice" data-pro-gate-notice>
            Материал о лекарственных средствах предназначен для специалистов.
            <a href={`/pro-dostup/?next=${encodeURIComponent(m.path)}`}>Подтвердить, что я специалист</a>.
          </p>
        )}
        <div class="prose" data-pro-only={d.pro_only ? 'true' : undefined} hidden={d.pro_only ? true : undefined}>
          <slot />
        </div>
        <Sources sources={d.sources} />
        {d.changelog.length > 0 && (
          <section aria-labelledby="changelog">
            <h2 id="changelog">История изменений</h2>
            <ul>
              {d.changelog.map((c: any) => (<li><time datetime={c.date.toISOString().slice(0, 10)}>{fmt(c.date)}</time>: {c.change}</li>))}
            </ul>
          </section>
        )}
      </div>
      <aside class="aside">
        <ReviewBlock data={d} draft={m.decision.draft} reason={m.decision.reason} />
        <section class="panel" aria-labelledby="disclosure">
          <p class="eyebrow">Интересы</p>
          <h2 id="disclosure">Раскрытие интересов</h2>
          <p>{d.disclosure}</p>
          <p><a href="/reklama-i-nezavisimost/">Правила рекламы и независимости <span class="arrow">→</span></a></p>
        </section>
        {d.medical && (
          <p class="notice" data-medical-disclaimer><small>Материал носит информационный характер и не заменяет консультацию врача. <a href="/medicinskaya-ogovorka/">Медицинская оговорка</a>.</small></p>
        )}
        {!m.decision.draft && <TelegramCta prefix={prefix} slug={rest.join('_')} />}
      </aside>
    </div>
  </article>
  {d.pro_only && (
    <script is:inline>
      try {
        if (localStorage.getItem('proba_pro_confirmed') === '1') {
          document.querySelectorAll('[data-pro-only]').forEach((el) => el.removeAttribute('hidden'));
          document.querySelectorAll('[data-pro-gate-notice]').forEach((el) => el.setAttribute('hidden', ''));
        }
      } catch (e) {}
    </script>
  )}
</Base>
